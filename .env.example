# Copy this file to backend/.env and add your own key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Cloud OAuth web client. Add this callback URI to the OAuth client:
# http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAILPILOT_TOKEN_ENCRYPTION_KEY=
MAILPILOT_DB_PATH=backend/data/mailpilot.sqlite3
MAILPILOT_FRONTEND_URL=http://localhost:5173
MAILPILOT_COOKIE_SECURE=false
MAILPILOT_AUTO_SEND_KILL_SWITCH=false
MAILPILOT_ENV=development
# Comma-separated stable owner IDs (google:<sub>) allowed to use the global emergency stop.
MAILPILOT_ADMIN_OWNER_IDS=
